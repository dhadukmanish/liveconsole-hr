// Live Console HR — Phase 1 schema.
//
// `directUrl` exists because port 6432 on site4now is a PgBouncer pooler:
// migrations cannot run through transaction-mode pooling, so they use the
// direct 5432 connection while the app runtime uses the pooled one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum PermissionModule {
  TASK
  ATTENDANCE
  LEAVE
  DOCUMENTS
  PHONEBOOK
  LICENSES
  USERS
  SETTINGS
}

enum PermissionAction {
  VIEW
  ADD
  EDIT
  DELETE
  APPROVE
}

enum LoginMethod {
  OTP
  PASSWORD
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

/// Roles are a table, not an enum, so more can be added without a migration.
/// `code` is what the permission and data-scope logic keys off.
model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// The catalogue of module x action pairs. Rows are seeded, never user-created.
model Permission {
  id     String           @id @default(cuid())
  module PermissionModule
  action PermissionAction

  roles RolePermission[]
  users UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String  @id @default(cuid())
  roleId       String
  permissionId String
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user override of the role default. `allowed = false` is a revoke, which
/// is why this cannot be a simple join table.
model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  allowed      Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id                 String      @id @default(cuid())
  mobile             String      @unique
  email              String?     @unique
  name               String
  roleId             String
  managerId          String?
  loginMethod        LoginMethod @default(OTP)
  /// bcrypt hash; null for OTP-only users.
  passwordHash       String?
  mustChangePassword Boolean     @default(false)
  status             UserStatus  @default(ACTIVE)
  /// BCP-47 short code: en | hi | gu.
  locale             String      @default("en")
  themePref          String      @default("system")
  lastLoginAt        DateTime?
  createdById        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  role      Role   @relation(fields: [roleId], references: [id])
  manager   User?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[] @relation("ManagerReports")
  createdBy User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created   User[] @relation("UserCreatedBy")

  profile           EmployeeProfile?
  permissions       UserPermission[]
  documents         Document[]       @relation("DocumentOwner")
  uploadedDocuments Document[]       @relation("DocumentUploader")
  otpCodes          OtpCode[]
  sessions          Session[]
  auditLogs         AuditLog[]

  @@index([managerId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model EmployeeProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  employeeCode     String?   @unique
  designation      String?
  department       String?
  dateOfJoining    DateTime?
  dateOfBirth      DateTime?
  bloodGroup       String?
  address          String?
  emergencyContact String?
  /// Path relative to UPLOAD_DIR, never a public URL.
  photoPath        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

model DocumentType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  requiresNumber Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents Document[]

  @@map("document_types")
}

model Document {
  id             String   @id @default(cuid())
  userId         String
  documentTypeId String
  /// Name the user recognises; display only.
  originalName   String
  /// Path relative to UPLOAD_DIR. Files are streamed by an authorised route,
  /// never served as static assets.
  storedPath     String
  mimeType       String
  sizeBytes      Int
  documentNumber String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  user         User         @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  uploadedBy   User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentTypeId])
  @@map("documents")
}

/// OTPs are stored hashed: a leaked database row must not be a usable login.
model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("otp_codes")
}

/// Server-side sessions, so blocking or deactivating a user takes effect on
/// their next request. A stateless JWT could not be revoked that way.
model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token exists only in the cookie.
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  summary     String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Masters — seeded in Phase 1, consumed by Phases 2 and 3.
// ---------------------------------------------------------------------------

model LeaveType {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  isPaid           Boolean  @default(true)
  annualDays       Int?
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("leave_types")
}

model TaskType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_types")
}

model TaskPriority {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  colour    String   @default("#6B6A65")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_priorities")
}

model TaskStatus {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  colour     String   @default("#6B6A65")
  isTerminal Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("task_statuses")
}
