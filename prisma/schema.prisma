// Live Console HR — Phase 1 schema.
//
// `directUrl` exists because port 6432 on site4now is a PgBouncer pooler:
// migrations cannot run through transaction-mode pooling, so they use the
// direct 5432 connection while the app runtime uses the pooled one.

generator client {
  provider      = "prisma-client-js"
  // The host runs Windows but this is built on Linux, so the Windows query
  // engine has to be fetched at generate time or the app cannot reach the
  // database once it is uploaded.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum PermissionModule {
  TASK
  ATTENDANCE
  LEAVE
  DOCUMENTS
  PHONEBOOK
  LICENSES
  USERS
  SETTINGS
}

enum PermissionAction {
  VIEW
  ADD
  EDIT
  DELETE
  APPROVE
}

enum LoginMethod {
  OTP
  PASSWORD
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

/// Roles are a table, not an enum, so more can be added without a migration.
/// `code` is what the permission and data-scope logic keys off.
model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// The catalogue of module x action pairs. Rows are seeded, never user-created.
model Permission {
  id     String           @id @default(cuid())
  module PermissionModule
  action PermissionAction

  roles RolePermission[]
  users UserPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String  @id @default(cuid())
  roleId       String
  permissionId String
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user override of the role default. `allowed = false` is a revoke, which
/// is why this cannot be a simple join table.
model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  allowed      Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id                 String      @id @default(cuid())
  mobile             String      @unique
  email              String?     @unique
  name               String
  roleId             String
  managerId          String?
  loginMethod        LoginMethod @default(OTP)
  /// bcrypt hash; null for OTP-only users.
  passwordHash       String?
  mustChangePassword Boolean     @default(false)
  status             UserStatus  @default(ACTIVE)
  /// BCP-47 short code: en | hi | gu.
  locale             String      @default("en")
  themePref          String      @default("system")
  lastLoginAt        DateTime?
  createdById        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  role      Role   @relation(fields: [roleId], references: [id])
  manager   User?  @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[] @relation("ManagerReports")
  createdBy User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  created   User[] @relation("UserCreatedBy")

  profile           EmployeeProfile?
  permissions       UserPermission[]
  documents         Document[]       @relation("DocumentOwner")
  uploadedDocuments Document[]       @relation("DocumentUploader")
  otpCodes          OtpCode[]
  sessions          Session[]
  auditLogs         AuditLog[]

  contactsCreated    Contact[]      @relation("ContactCreator")
  licensesOwned      License[]      @relation("LicenseOwner")
  licensesCreated    License[]      @relation("LicenseCreator")
  tasksAssigned      Task[]         @relation("TaskAssignee")
  tasksCreated       Task[]         @relation("TaskCreator")
  attendance         Attendance[]   @relation("AttendanceOwner")
  attendanceRecorded Attendance[]   @relation("AttendanceRecorder")
  leaveRequests      LeaveRequest[] @relation("LeaveOwner")
  leaveDecisions     LeaveRequest[] @relation("LeaveApprover")

  @@index([managerId])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model EmployeeProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  employeeCode     String?   @unique
  designation      String?
  department       String?
  dateOfJoining    DateTime?
  dateOfBirth      DateTime?
  bloodGroup       String?
  address          String?
  emergencyContact String?
  /// Path relative to UPLOAD_DIR, never a public URL.
  photoPath        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

model DocumentType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  requiresNumber Boolean  @default(false)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents Document[]

  @@map("document_types")
}

model Document {
  id             String   @id @default(cuid())
  userId         String
  documentTypeId String
  /// Name the user recognises; display only.
  originalName   String
  /// Path relative to UPLOAD_DIR. Files are streamed by an authorised route,
  /// never served as static assets.
  storedPath     String
  mimeType       String
  sizeBytes      Int
  documentNumber String?
  uploadedById   String?
  createdAt      DateTime @default(now())

  user         User         @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  uploadedBy   User?        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentTypeId])
  @@map("documents")
}

/// OTPs are stored hashed: a leaked database row must not be a usable login.
model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("otp_codes")
}

/// Server-side sessions, so blocking or deactivating a user takes effect on
/// their next request. A stateless JWT could not be revoked that way.
model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token exists only in the cookie.
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  summary     String?
  meta        Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Masters — seeded in Phase 1, consumed by Phases 2 and 3.
// ---------------------------------------------------------------------------

model LeaveType {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  isPaid           Boolean        @default(true)
  annualDays       Int?
  requiresApproval Boolean        @default(true)
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  requests         LeaveRequest[]

  @@map("leave_types")
}

model TaskType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@map("task_types")
}

model TaskPriority {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  colour    String   @default("#6B6A65")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@map("task_priorities")
}

model TaskStatus {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  colour     String   @default("#6B6A65")
  isTerminal Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tasks Task[]

  @@map("task_statuses")
}

// ---------------------------------------------------------------------------
// Phase 2 — attendance and leave
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ON_LEAVE
  ABSENT
}

/// One row per person per working day. `workDate` is the day in India, not UTC:
/// a 9pm IST check-in is still that day's attendance, and the host runs in UTC.
model Attendance {
  id            String           @id @default(cuid())
  userId        String
  workDate      DateTime         @db.Date
  checkInAt     DateTime?
  checkOutAt    DateTime?
  status        AttendanceStatus @default(PRESENT)
  /// Minutes between check-in and check-out, stored so reports do not have to
  /// recompute it and so a later edit cannot silently change history.
  workedMinutes Int?
  note          String?
  /// Who recorded it, when an admin marks attendance on someone's behalf.
  recordedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user       User  @relation("AttendanceOwner", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([userId, workDate])
  @@index([workDate])
  @@map("attendance")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  leaveTypeId  String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  /// Half days are common enough here to be worth storing rather than deriving.
  isHalfDay    Boolean     @default(false)
  days         Float
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user      User      @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  decidedBy User?     @relation("LeaveApprover", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId, startDate])
  @@index([status])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Phase 3 — tasks
// ---------------------------------------------------------------------------

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  /// All three point at the seeded masters, so a company can rename or add
  /// statuses without a migration — the board renders whatever is active.
  taskTypeId     String?
  taskPriorityId String
  taskStatusId   String
  assigneeId     String?
  createdById    String
  dueDate        DateTime? @db.Date
  completedAt    DateTime?
  /// Position within its status column, for ordering on the board.
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  taskType     TaskType?    @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  taskPriority TaskPriority @relation(fields: [taskPriorityId], references: [id])
  taskStatus   TaskStatus   @relation(fields: [taskStatusId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, taskStatusId])
  @@index([taskStatusId])
  @@index([dueDate])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Phase 4 — phone book, licenses and reminders
// ---------------------------------------------------------------------------

model Contact {
  id          String   @id @default(cuid())
  name        String
  company     String?
  designation String?
  phone       String
  altPhone    String?
  email       String?
  /// Free text rather than a master: the list of categories a company uses
  /// changes constantly, and existing values are offered as suggestions.
  category    String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([category])
  @@map("contacts")
}

model License {
  id               String    @id @default(cuid())
  name             String
  vendor           String?
  licenseNumber    String?
  startDate        DateTime? @db.Date
  expiryDate       DateTime  @db.Date
  cost             Float?
  ownerId          String?
  /// How many days before expiry the reminder should start. Per record,
  /// because a domain and an insurance policy do not need the same notice.
  remindDaysBefore Int       @default(30)
  notes            String?
  isActive         Boolean   @default(true)
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner     User? @relation("LicenseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User? @relation("LicenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([expiryDate])
  @@map("licenses")
}

enum ReminderKind {
  LICENSE_EXPIRY
  LEAVE_PENDING
}

/// One row per thing reminded about per day. The unique key is what makes the
/// cron endpoint safe to call repeatedly: cron-job.org retries, and nobody
/// wants four texts about the same licence.
model ReminderLog {
  id        String       @id @default(cuid())
  kind      ReminderKind
  entityId  String
  /// The India-local date the reminder was sent for, as YYYY-MM-DD.
  dayKey    String
  recipient String
  channel   String
  detail    String?
  createdAt DateTime     @default(now())

  @@unique([kind, entityId, dayKey, recipient])
  @@index([createdAt])
  @@map("reminder_logs")
}
