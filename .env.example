# Copy to .env and fill in. NEVER commit .env.
#
# Runtime connection. Port 6432 on site4now is a PgBouncer pooler, so
# pgbouncer=true and connection_limit=1 are required: shared hosting caps
# connections hard and Prisma's prepared statements break through a
# transaction-mode pooler without that flag.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6432/DBNAME?pgbouncer=true&connection_limit=1&sslmode=prefer"

# Direct (non-pooled) connection used only by `prisma migrate`. Migrations
# cannot run through a transaction-mode pooler. Usually the same host on 5432.
# If 5432 is not reachable, see DEPLOY.md for the SQL-by-hand path.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=prefer"

# 32+ random bytes, base64. Signs session cookies. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Where uploaded documents live on the host. Must be writable by the app pool
# and must NOT be inside the web-servable root.
UPLOAD_DIR="./App_Data/uploads"

# Shows the "beta" banner. Set to "false" only when you tell us to go live.
NEXT_PUBLIC_BETA_BANNER="true"

# SMS provider. "console" logs the OTP (dev). "msg91" uses the keys below.
SMS_PROVIDER="console"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# Bearer token for /api/cron/reminders, which an external scheduler
# (cron-job.org) calls once a day. Shared hosting has no cron of its own.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If left empty, the deploy derives one from AUTH_SECRET.
CRON_SECRET=""

# Separate DLT template for reminders. MSG91 rejects a reminder sent through an
# OTP template, so reminders refuse to send by SMS until this is set.
MSG91_REMINDER_TEMPLATE_ID=""

# Where the JSON snapshots from /api/cron/backup land. Must be writable by the
# app pool and outside the web root; App_Data is hidden by IIS by default.
BACKUP_DIR="./App_Data/backups"

# --- WhatsApp (Phase 5) ------------------------------------------------------
# Which channel the outbox uses: whatsapp | sms | console. Leave unset and it is
# inferred — WhatsApp if the credentials below are set, else MSG91 if
# SMS_PROVIDER=msg91, else the server log.
NOTIFY_CHANNEL=""

# WhatsApp Cloud API (Meta). From the Meta app dashboard: WhatsApp > API Setup.
# The access token must be a permanent System User token, not the 24-hour test
# token, or sending stops working tomorrow.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Optional: the Graph version and the approved templates' language.
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANG="en"

# Optional per-event template names. The default is the event name itself, so a
# template created in Meta as leave_approved needs nothing here. Events:
# leave_applied, leave_approved, leave_rejected, leave_pending, task_assigned,
# license_expiry, license_expired.
# WHATSAPP_TEMPLATE_LEAVE_APPROVED="leave_approved_v2"

# Which route a login code takes: whatsapp | sms. Unset prefers WhatsApp when
# the credentials above are set, and falls back to SMS whenever WhatsApp cannot
# reach the number — plenty of numbers are not on WhatsApp, and Meta only says so
# when you try.
OTP_CHANNEL=""

# Meta puts login codes in their own "authentication" template category, so this
# is a different template from the notification ones.
WHATSAPP_OTP_TEMPLATE="login_code"
# Which button that template was approved with: copy_code | url | none.
WHATSAPP_OTP_BUTTON="copy_code"
